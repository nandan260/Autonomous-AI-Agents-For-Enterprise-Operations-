# Optional: Set your Gemini API key for intelligent multimodal document extraction
# If left blank, system automatically uses high-precision rule-based extraction fallback
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (Defaults to SQLite in ./backend/onboarding.db if left unset)
