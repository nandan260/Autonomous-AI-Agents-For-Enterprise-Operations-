# POSTGRES_PASSWORD=change_me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=onboarding
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/onboarding
